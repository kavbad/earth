# apps/web — environment for `next dev` / `next build` / `next start`.
#
# The canonical, fully documented list is the repository root `.env.example`; every variable is
# validated by @earth/config (packages/config/src/env.ts, ARCHITECTURE.md §14, spec §106).
# Copy this file to apps/web/.env.local (never committed) or export the variables in the shell.
# Optional variables may be left empty: `KEY=` is treated as unset.

# ----------------------------------------------------------------------------------------
# Public (inlined into the client bundle; read through lib/supabase/public-env.ts)
# ----------------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
# development | preview | production
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_WEB_ORIGIN=http://localhost:3000

# ----------------------------------------------------------------------------------------
# Server tier (app/api/** via packages/server; read through lib/server/env.ts).
# Secrets: never commit real values, never ship to clients.
# ----------------------------------------------------------------------------------------
# Falls back to NEXT_PUBLIC_APP_ENV when unset; the two must agree.
APP_ENV=development
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# At least 32 characters.
SUPABASE_JWT_SECRET=replace-with-a-secret-of-at-least-32-chars
# `livekit-server --dev` (the local stack) uses devkey / secret.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=ws://localhost:7880
# mock | manual_review | vendor. mock is refused when APP_ENV=production.
HUMAN_VERIFICATION_PROVIDER=mock
HUMAN_VERIFICATION_VENDOR_URL=
HUMAN_VERIFICATION_VENDOR_KEY=
HUMAN_VERIFICATION_WEBHOOK_SECRET=
# Expo push access token. Empty disables push delivery (dispatch marks notifications handled).
EXPO_ACCESS_TOKEN=
# Shared secret for /api/internal/* cron routes, sent as `x-earth-cron-secret`. At least 16 chars.
INTERNAL_CRON_SECRET=replace-with-cron-secret
POSTHOG_SERVER_KEY=
# Sentry DSN for the server tier. Empty selects the no-op monitor.
SENTRY_DSN=
ROOM_GRACE_SECONDS=120

# ----------------------------------------------------------------------------------------
# Platform variables (not part of the @earth/config schemas)
# ----------------------------------------------------------------------------------------
# Vercel Cron (vercel.json) calls /api/internal/* with a GET and no custom headers; when this
# variable is set in the Vercel project, Vercel adds `Authorization: Bearer <CRON_SECRET>`.
# lib/server/cron.ts accepts that bearer (constant-time compare) as the cron credential and
# forwards INTERNAL_CRON_SECRET to the handlers; setting both to the same value also works.
# Leave empty outside Vercel — `x-earth-cron-secret: <INTERNAL_CRON_SECRET>` always works.
CRON_SECRET=
# Structured log threshold: debug | info | warn | error. Default: info
LOG_LEVEL=
# Set by Vercel builds automatically; used in the Sentry release name (earth-web@<version>+<sha>).
VERCEL_GIT_COMMIT_SHA=
