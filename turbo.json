{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "envMode": "loose",
  "globalEnv": ["APP_ENV", "NODE_ENV", "CI"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "E2E_BASE_URL",
    "PLAYWRIGHT_BROWSERS_PATH",
    "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD",
    "NODE_OPTIONS",
    "HTTP_PROXY",
    "HTTPS_PROXY",
    "NO_PROXY",
    "http_proxy",
    "https_proxy",
    "no_proxy",
    "EXPO_NO_TELEMETRY",
    "NEXT_TELEMETRY_DISABLED",
    "TURBO_TELEMETRY_DISABLED"
  ],
  "tasks": {
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NEXT_PUBLIC_*",
        "EXPO_PUBLIC_*",
        "SUPABASE_SERVICE_ROLE_KEY",
        "SUPABASE_JWT_SECRET",
        "LIVEKIT_API_KEY",
        "LIVEKIT_API_SECRET",
        "LIVEKIT_URL",
        "HUMAN_VERIFICATION_PROVIDER",
        "HUMAN_VERIFICATION_VENDOR_URL",
        "HUMAN_VERIFICATION_VENDOR_KEY",
        "HUMAN_VERIFICATION_WEBHOOK_SECRET",
        "EXPO_ACCESS_TOKEN",
        "INTERNAL_CRON_SECRET",
        "POSTHOG_SERVER_KEY",
        "SENTRY_DSN",
        "ROOM_GRACE_SECONDS"
      ]
    },
    "//#lint:root": {
      "outputs": []
    },
    "//#typecheck:root": {
      "outputs": []
    },
    "//#test:root": {
      "outputs": []
    }
  }
}
