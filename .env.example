# Earth — environment variables.
#
# Every variable here is validated by @earth/config (packages/config/src/env.ts; ARCHITECTURE.md §14,
# spec §106). `describeEnv()` in that package is the machine-readable version of this file.
#
# Copy to .env (never committed) and replace the placeholders. Every value below is safe to share.
# Optional variables may be left empty: `KEY=` is treated as unset.
#
# Public variables are inlined into client bundles, so they exist twice — under NEXT_PUBLIC_ for
# apps/web and under EXPO_PUBLIC_ for apps/mobile — because each bundler only inlines its own prefix.
# Keep the two blocks identical except where the mobile device needs a reachable host (see notes).

# =========================================================================================
# Web public (apps/web) — read through loadPublicEnv(process.env-like object, 'NEXT_PUBLIC_')
# =========================================================================================

# Supabase project URL. Locally the stack fronts PostgREST (3001) and GoTrue (9999) on this origin.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
# Supabase anon key: a JWT for role "anon" signed with SUPABASE_JWT_SECRET. RLS governs what it can read.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# Origin of the Node server tier (apps/web /api routes). Default: http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
# LiveKit websocket URL clients connect to with a server-minted token. Default: ws://localhost:7880
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
# PostHog project key (optional). Empty selects the noop analytics adapter.
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog ingestion host (optional).
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Sentry DSN for the web client (optional). Empty disables error monitoring.
NEXT_PUBLIC_SENTRY_DSN=
# MapLibre style JSON URL rendered by the Earth map.
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
# development | preview | production. Default: development
NEXT_PUBLIC_APP_ENV=development
# Canonical web origin for share links and deep links (https://earth.social in production).
# Must be an origin: scheme://host[:port], no path. Default: http://localhost:3000
NEXT_PUBLIC_WEB_ORIGIN=http://localhost:3000

# =========================================================================================
# Mobile public (apps/mobile) — read through loadPublicEnv(..., 'EXPO_PUBLIC_')
# =========================================================================================
# Note: a phone or emulator cannot reach "localhost" on your machine. Use your LAN IP
# (for example http://192.168.1.20:3001) or 10.0.2.2 on the Android emulator for the local stack.

EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_LIVEKIT_URL=ws://localhost:7880
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_WEB_ORIGIN=http://localhost:3000

# =========================================================================================
# Server (apps/web /api routes via packages/server) — read through loadServerEnv(process.env)
# Never shipped to clients. Do not commit real values (spec §106).
# =========================================================================================

# development | preview | production. Default: development. Also read by `pnpm db:reset`
# (seeds are applied only when APP_ENV != production) and passed through turbo.
APP_ENV=development
# Supabase service-role key. Bypasses RLS; only the server tier may hold it.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Secret that signs and verifies Supabase JWTs (GoTrue + PostgREST share it). At least 32 characters.
SUPABASE_JWT_SECRET=replace-with-a-secret-of-at-least-32-chars
# LiveKit API credentials used to mint room tokens and verify webhooks.
# `livekit-server --dev` (the local stack) uses devkey / secret.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# LiveKit server URL the server tier talks to. Default: ws://localhost:7880
LIVEKIT_URL=ws://localhost:7880
# Human verification provider: mock | manual_review | vendor.
# mock is REFUSED when APP_ENV=production; vendor requires the three vendor settings below.
HUMAN_VERIFICATION_PROVIDER=mock
# Vendor API base URL (required when HUMAN_VERIFICATION_PROVIDER=vendor).
HUMAN_VERIFICATION_VENDOR_URL=
# Vendor API key (required when HUMAN_VERIFICATION_PROVIDER=vendor).
HUMAN_VERIFICATION_VENDOR_KEY=
# Secret that authenticates vendor callbacks to /api/claim/verification/webhook
# (required when HUMAN_VERIFICATION_PROVIDER=vendor).
HUMAN_VERIFICATION_WEBHOOK_SECRET=
# Expo push access token (optional; https://expo.dev/accounts/<account>/settings/access-tokens).
# Empty disables push dispatch.
EXPO_ACCESS_TOKEN=
# Shared secret required by /api/internal/* cron routes. At least 16 characters.
INTERNAL_CRON_SECRET=replace-with-cron-secret
# PostHog server-side project key (optional; posthog-node). Empty selects the noop adapter.
POSTHOG_SERVER_KEY=
# Sentry DSN for the server tier (optional). Empty disables error monitoring.
SENTRY_DSN=
# Seconds a room stays open with no active Humans before rooms_sweep() ends it. Default: 120
ROOM_GRACE_SECONDS=120

# =========================================================================================
# Local tooling — not part of the @earth/config schemas
# =========================================================================================

# Postgres used by `pnpm db:reset`, `pnpm db:test` and the local stack (scripts/local-stack).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/earth_local
# Base URL Playwright targets (defaults to http://localhost:3000 when unset).
E2E_BASE_URL=http://localhost:3000

# =========================================================================================
# Deploy-time only — not part of the @earth/config schemas, not read at runtime
# =========================================================================================
# Read by `pnpm exec tsx apps/web/lib/deeplinks/generate-well-known.ts`, which rewrites
# apps/web/public/.well-known/{apple-app-site-association,assetlinks.json} from these values
# (spec §112; docs/DEPLOYMENT.md §4). Unset leaves the committed placeholders in place, and
# universal links then fall back to the web page instead of opening the app.

# Apple Developer team id (10 characters); pairs with IOS_BUNDLE_ID as the app ID.
APPLE_TEAM_ID=
# iOS bundle identifier. Default: social.earth.app
IOS_BUNDLE_ID=social.earth.app
# Android application id. Default: social.earth.app
ANDROID_PACKAGE_NAME=social.earth.app
# Comma-separated SHA-256 signing certificate fingerprints of the key that signs the shipped
# artifact (with Play App Signing this is Google's app signing key, not the upload key).
ANDROID_SHA256_CERT_FINGERPRINTS=
